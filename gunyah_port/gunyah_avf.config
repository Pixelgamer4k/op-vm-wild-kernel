# Recommended .config fragment for the Gunyah AVF port on SM8550 / 12R
# Merge into your kernel defconfig / gki fragment before building.

# Required gate: drivers/Makefile only builds virt/ when this is set.
CONFIG_VIRT_DRIVERS=y

# Modern AVF /dev/gunyah (ioctl type 'G') — required for crosvm.
CONFIG_GUNYAH=y
CONFIG_GUNYAH_PLATFORM_HOOKS=y
CONFIG_GUNYAH_QCOM_PLATFORM=y
CONFIG_GUNYAH_VCPU=y
CONFIG_GUNYAH_IRQFD=y
CONFIG_GUNYAH_IOEVENTFD=y

# Legacy OEM secure loader (gh_main → /dev/qgunyah) needs vendor-only
# headers/APIs that GKI common lacks. Disable for Phase 1 AVF bring-up;
# stock vendor gunyah.ko remains blacklisted so /dev/gunyah is ours.
# CONFIG_GH_SECURE_VM_LOADER is not set
# CONFIG_GH_PROXY_SCHED is not set

# Shared helpers used by modern RM path
CONFIG_GUNYAH_DRIVERS=y
CONFIG_GH_CTRL=y
CONFIG_GH_DBL=y
CONFIG_GH_MSGQ=y
CONFIG_GH_RM_DRV=y
CONFIG_GH_IRQ_LEND=y
CONFIG_GH_MEM_NOTIFIER=y
CONFIG_GH_GUEST_POPS=y
# CONFIG_GH_VIRT_WATCHDOG is not set

# GKI common has no qcom secure-buffer driver; use header stubs if needed.
# CONFIG_QCOM_SECURE_BUFFER is not set
