# Gunyah AVF port — boot-safe minimal config for SM8550 / 12R.
# CONFIG_GUNYAH_QCOM_PLATFORM is intentionally off: its module_init
# issued Vendor-HYP UUID SMCCC calls that hard-reset this firmware.

CONFIG_VIRT_DRIVERS=y

CONFIG_GUNYAH=y
CONFIG_GUNYAH_PLATFORM_HOOKS=y
# CONFIG_GUNYAH_QCOM_PLATFORM is not set
CONFIG_GUNYAH_VCPU=y
CONFIG_GUNYAH_IRQFD=y
CONFIG_GUNYAH_IOEVENTFD=y

# CONFIG_GH_SECURE_VM_LOADER is not set
# CONFIG_GH_PROXY_SCHED is not set
# CONFIG_GUNYAH_DRIVERS is not set
# CONFIG_GH_VIRT_WATCHDOG is not set
# CONFIG_GH_CTRL is not set
# CONFIG_GH_DBL is not set
# CONFIG_GH_MSGQ is not set
# CONFIG_GH_RM_DRV is not set
# CONFIG_GH_IRQ_LEND is not set
# CONFIG_GH_MEM_NOTIFIER is not set
# CONFIG_GH_GUEST_POPS is not set
# CONFIG_QCOM_SECURE_BUFFER is not set
